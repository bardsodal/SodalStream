# Ingest folder: drop series folders with episodes here. Every file is
# converted into LIBRARY_DIR on scan and the original is then DELETED.
MEDIA_ROOT=C:\Users\you\Videos\SodalStreamInput

# Permanent home of converted episodes — the only copy once ingest completes.
# (default: <repo>\library)
# LIBRARY_DIR=C:\Users\you\Videos\SodalStreamLibrary

# Where the database and generated thumbnails live (default: <repo>\cache)
# CACHE_DIR=D:\SodalStreamCache

# Port for the server (UI is served here in production mode)
# PORT=4321
